    int d = 1 - (int)r;//could be 1.25 -r
    while( sx <= sy){
      drawPoint(x + sx, y + sy, 0);
      drawPoint(x - sx, y + sy, 0);
      drawPoint(x + sx, y - sy, 0);
      drawPoint(x - sx, y - sy, 0);
      drawPoint(x + sy, y + sx, 0);
      drawPoint(x - sy, y + sx, 0);
      drawPoint(x + sy, y - sx, 0);
      drawPoint(x - sy, y - sx, 0);
      if(d > 0){
        sy -=1;
        d += 2* (sx - sy) +1 ;
      }else{
        d += 2 * sx +1;
      }
      sx ++;
    }
    
